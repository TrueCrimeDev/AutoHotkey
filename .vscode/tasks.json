{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/C", "${workspaceFolder}/vsc-build-env.cmd", "&&"]
            }
        },
        "problemMatcher": "$msCompile"
    },
    "tasks": [
        {
            // Runs the active file with the fork build in the integrated
            // TERMINAL (VT-capable) — so ANSI escapes render in color, unlike
            // the AHK extension's Run button which uses the non-VT OUTPUT panel.
            "label": "Run AHK (fork, color)",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\AutoHotkey64.exe",
            "args": ["${file}"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Run AHK with Debug Interceptor",
            "type": "shell",
            "command": "& 'C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe' '${workspaceFolder}\\AutoDebug.ahk' '${file}'",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Run AHK Normally (No Debug)",
            "type": "shell",
            "command": "& 'C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe' '${file}'",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": []
        },
        {
            "label": "Start Global Debug Server",
            "type": "shell",
            "command": "& 'C:\\Program Files\\AutoHotkey\\v2\\AutoHotkey64.exe' '${workspaceFolder}\\GlobalDebugServer.ahk'",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=${input:platform}",
                "/p:Configuration=${input:buildconfig}",
                "/t:build",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=${input:platform}",
                "/p:Configuration=${input:buildconfig}",
                "/t:Rebuild",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": "build"
        },
        {
            "label": "build-debug",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=x64",
                "/p:Configuration=Debug",
                "/t:build",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": "build"
        }
    ],
    "inputs": [
        {
            "id": "platform",
            "description": "Platform",
            "type": "pickString",
            "options": [
                "x64",
                "Win32"
            ],
            "default": "x64"
        },
        {
            "id": "buildconfig",
            "description": "Build Configuration",
            "type": "pickString",
            "options": [
                "Release",
                "Debug"
            ],
            "default": "Release"
        }
    ]
}