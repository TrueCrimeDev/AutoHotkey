{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/C", "${workspaceFolder}/vsc-build-env.cmd", "&&"]
            }
        },
        "problemMatcher": "$msCompile"
    },
    "tasks": [
        {
            // Runs the active file with the fork build in the integrated
            // TERMINAL (VT-capable) — so ANSI escapes render in color, unlike
            // the AHK extension's Run button which uses the non-VT OUTPUT panel.
            "label": "Run AHK (fork, color)",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\AutoHotkey64.exe",
            "args": ["${file}"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": []
        },
        {
            // Syntax-check the active file with the fork engine (exit 13 = fail).
            // The matcher turns `file (line) : ==> msg` into clickable entries
            // in the Problems panel.
            "label": "Check AHK (fork)",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\AutoHotkey64.exe",
            "args": ["check", "/ErrorStdOut", "${file}"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "ahk",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+) \\((\\d+)\\) : ==> (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            // Run the active file through the engine's test runner (exit 14 = fail).
            "label": "Test AHK (fork)",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\AutoHotkey64.exe",
            "args": ["test", "/ErrorStdOut", "${file}"],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "ahk",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+) \\((\\d+)\\) : ==> (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            // Whole-tree regression suite (qa/run.ahk, subprocess-per-test).
            // Exit code = failing assertions + crashes.
            "label": "QA suite (fork)",
            "type": "process",
            "command": "${workspaceFolder}\\bin\\AutoHotkey64.exe",
            "args": ["/ErrorStdOut", "${workspaceFolder}\\qa\\run.ahk"],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "panel": "dedicated",
                "showReuseMessage": false,
                "clear": true
            },
            "problemMatcher": {
                "owner": "ahk",
                "fileLocation": "absolute",
                "pattern": {
                    "regexp": "^(.+) \\((\\d+)\\) : ==> (.+)$",
                    "file": 1,
                    "line": 2,
                    "message": 3
                }
            }
        },
        {
            // Canonical engine build: mingw-w64 GCC via C:\msys64 → bin\.
            // (build.bat; the msbuild tasks below are the legacy MSVC route.)
            "label": "build (fork, mingw)",
            "type": "process",
            "command": "cmd.exe",
            "args": ["/C", "${workspaceFolder}\\build.bat"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=${input:platform}",
                "/p:Configuration=${input:buildconfig}",
                "/t:build",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": "build"
        },
        {
            "label": "rebuild",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=${input:platform}",
                "/p:Configuration=${input:buildconfig}",
                "/t:Rebuild",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": "build"
        },
        {
            "label": "build-debug",
            "type": "shell",
            "command": "msbuild",
            "args": [
                "/p:Platform=x64",
                "/p:Configuration=Debug",
                "/t:build",
                "/p:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary",
                "${workspaceFolder}/AutoHotkeyx.sln"
            ],
            "group": "build"
        }
    ],
    "inputs": [
        {
            "id": "platform",
            "description": "Platform",
            "type": "pickString",
            "options": [
                "x64",
                "Win32"
            ],
            "default": "x64"
        },
        {
            "id": "buildconfig",
            "description": "Build Configuration",
            "type": "pickString",
            "options": [
                "Release",
                "Debug"
            ],
            "default": "Release"
        }
    ]
}
