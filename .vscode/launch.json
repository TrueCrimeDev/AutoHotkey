{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            // Debugs the engine itself (C++), running it on the active .ahk file
            // (focus the script before pressing F5). The preLaunchTask builds the
            // CMake MSVC x64 Debug console engine; CMakeLists.txt appends _debug to
            // AHK_OUTPUT_DIR, so it lands in out\msvc\x64_debug. Needs
            // ms-vscode.cpptools (recommended in .vscode/extensions.json) plus
            // Visual Studio 2022 / Build Tools 18, CMake and Ninja. If the build
            // fails, do not choose "Debug Anyway".
            "name": "Debug engine (C++, CMake MSVC x64 Debug console)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/out/msvc/x64_debug/AutoHotkey64Console.exe",
            "args": ["${file}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build-debug (CMake, MSVC x64 -> out/msvc/x64_debug)"
        },
        {
            // Legacy Visual Studio solution route: Debug|x64 GUI build in
            // bin_debug\ (no console target). If the build fails, do not choose
            // "Debug Anyway": an existing bin_debug exe may predate the CLI.
            "name": "Debug engine (C++, msbuild .sln GUI Debug x64)",
            "type": "cppvsdbg",
            "request": "launch",
            "program": "${workspaceFolder}/bin_debug/AutoHotkey64.exe",
            "args": ["${file}"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "preLaunchTask": "build-debug (msbuild .sln, GUI only, x64 -> bin_debug)"
        },
        {
            // Debugs the active .ahk script over DBGp with the fork engine (the
            // bin\*.exe engines are gitignored: build one first, see BUILD.md).
            // Requires the zero-plusplus.vscode-autohotkey-debug extension, which
            // provides the "autohotkey" debug type; the thqby AutoHotkey2 LSP does
            // not include a debugger and asks for one. Without it VS Code reports
            // that the debug type is not supported. .vscode/extensions.json
            // recommends it, so VS Code offers to install it (see
            // docs/VSCODE_SETUP.md).
            // Attributes checked 2026-10-09 against that extension's package.json
            // (1.11.1, contributes.debuggers[0].configurationAttributes.launch):
            // "runtime" string; "program" string (default ${file}); "args" string
            // array; "useDebugDirective" boolean or object; "variableCategories"
            // "recommend" or an array of {label, source Local|Static|Global,
            // noduplicate, hidden, matchers: [{className} | {builtin} | {pattern,
            // ignorecase, type, static, method}]}. Defaults the adapter fills in:
            // "runtimeArgs" ["/ErrorStdOut"] (accepted by the fork, where it only
            // selects the stderr encoding), "port" 9002, "hostname" "localhost",
            // "stopOnEntry" false, "useAutoJumpToError" false, "useOutputDebug"
            // true, "useAnnounce" true, "maxChildren" 10000.
            // Runtime: the adapter starts it with Node's child_process.spawn
            // (stdout and stderr piped into the Debug Console, no windowsHide), so
            // the console-subsystem bin\AutoHotkey64Console.exe would open its own
            // console window on every launch. The GUI build is used instead; its
            // Print output and stderr still arrive through the pipes. Both bin\
            // exes come from the same CI build (f14d7427, run 37807040408), so
            // the GUI one has the same features (inspect, processPipe, coverage).
            // No prompt on a missing or lost debugger: with either exe, if
            // nothing listens on the port, or the adapter goes away, the script
            // runs on without the debugger and only stderr says so ("Debugger
            // error: ... continuing without the debugger."); the GUI exe has no
            // console to show it.
            // Port: zero-plusplus listens on 9002 by default. Unless the active
            // editor is an AHK v1 file, thqby merges its AutoHotkey2.DebugConfiguration
            // setting (default port "9002-9100") into this configuration. The
            // user-wide 'ahk' MCP server's DBGp listener (mcp__ahk__AHK_Debug_DBGp;
            // debug toolset, hidden by default) starts at 9000 and moves to 9001+
            // when busy, so the two normally coexist. The project's ahk-mcp server
            // (.mcp.json, the engine's native mcp verb) has no DBGp tool.
            "name": "Debug AHK script (DBGp, fork engine)",
            "type": "autohotkey",
            "request": "launch",
            "program": "${file}",
            "runtime": "${workspaceFolder}/bin/AutoHotkey64.exe",
            "useDebugDirective": true,
            "args": [],
            "variableCategories": [
                {
                    "label": "Local",
                    "source": "Local"
                },
                {
                    "label": "Static",
                    "source": "Static"
                },
                {
                    "label": "Global",
                    "source": "Global",
                    "noduplicate": true
                },
                {
                    "label": "Global Classes",
                    "source": "Global",
                    "matchers": [
                        {
                            "className": "Class"
                        }
                    ]
                },
                {
                    "label": "Global Functions",
                    "source": "Global",
                    "matchers": [
                        {
                            "className": "Func"
                        }
                    ]
                },
                {
                    "label": "Built-in Global",
                    "source": "Global",
                    "matchers": [
                        {
                            "builtin": true
                        }
                    ]
                }
            ]
        }
    ]
}
